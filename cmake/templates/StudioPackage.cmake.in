cmake_minimum_required(VERSION 3.20)
set(build_root "@PROJECT_BINARY_DIR@")
set(configuration "$<CONFIG>")
if(NOT configuration MATCHES "^(Debug|Release|RelWithDebInfo|MinSizeRel)$")
  message(FATAL_ERROR "Unsupported package configuration: ${configuration}")
endif()
file(REAL_PATH "${build_root}" build_root)
set(package_root "${build_root}/package/${configuration}/MVStudio")
# Refuse redirected paths before cleaning the fixed, build-owned staging folder.
foreach(directory "${build_root}/package" "${build_root}/package/${configuration}" "${package_root}")
  if(IS_SYMLINK "${directory}")
    message(FATAL_ERROR "Package directory must not be a link: ${directory}")
  endif()
  if(EXISTS "${directory}")
    file(REAL_PATH "${directory}" resolved)
    if(NOT resolved STREQUAL directory)
      message(FATAL_ERROR "Package directory resolves elsewhere: ${directory}")
    endif()
  endif()
endforeach()
file(REMOVE_RECURSE "${package_root}")
file(MAKE_DIRECTORY "${package_root}/platforms" "${package_root}/third-party")
set(executables "$<TARGET_FILE:mvkit_workbench>" "$<TARGET_FILE:mvkit_studio_worker>")
set(libraries "$<TARGET_FILE:mvkit>" "$<TARGET_FILE:mvkitcpp>"
  "$<TARGET_FILE:Qt5::Core>" "$<TARGET_FILE:Qt5::Gui>" "$<TARGET_FILE:Qt5::Widgets>")
set(platform "@qt_bin@/../plugins/platforms/qwindows$<$<CONFIG:Debug>:d>.dll")
file(COPY ${executables} ${libraries} DESTINATION "${package_root}")
file(COPY "${platform}" DESTINATION "${package_root}/platforms")
# Resolve the staged copies together, not two identical Qt copies from the SDK
# and developer bin folders. This also tests the actual package search layout.
foreach(kind executables libraries)
  set(staged)
  foreach(binary IN LISTS ${kind})
    get_filename_component(name "${binary}" NAME)
    list(APPEND staged "${package_root}/${name}")
  endforeach()
  set(${kind} ${staged})
endforeach()
get_filename_component(platform_name "${platform}" NAME)
set(platform "${package_root}/platforms/${platform_name}")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@mvkit_runtime_dependency_command@")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "@mvkit_runtime_dependency_tool@")
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${executables} LIBRARIES ${libraries} MODULES "${platform}"
  DIRECTORIES "${package_root}" "$<TARGET_FILE_DIR:mvkit>" "@qt_bin@"
    "$<TARGET_FILE_DIR:JPEG::JPEG>" "$<TARGET_FILE_DIR:PNG::PNG>" "$<TARGET_FILE_DIR:@mvkit_tiff_runtime_target@>"
  RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
  PRE_EXCLUDE_REGEXES "api-ms-win-.*" "ext-ms-win-.*"
  POST_EXCLUDE_REGEXES ".*[Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*")
if(unresolved)
  message(FATAL_ERROR "Missing Studio runtime dependencies: ${unresolved}")
endif()
foreach(library IN LISTS resolved)
  get_filename_component(name "${library}" NAME)
  string(TOLOWER "${name}" lower_name)
  if(lower_name MATCHES "halcon")
    message(FATAL_ERROR "Vendor development runtimes must not enter the Studio package: ${name}")
  endif()
  file(COPY "${library}" DESTINATION "${package_root}")
endforeach()
# Never copy the developer bin directory or local HALCON fixtures wholesale.
foreach(bundle @mvkit_studio_bundles@)
  file(COPY "@PROJECT_SOURCE_DIR@/examples/studio/${bundle}" DESTINATION "${package_root}/studio-examples")
endforeach()
file(COPY "@PROJECT_SOURCE_DIR@/examples/studio/data/synthetic" DESTINATION "${package_root}/studio-examples/data")
foreach(component qtbase-5.15.2 fluentui-system-icons lucide-icons)
  file(COPY "@PROJECT_SOURCE_DIR@/apps/third-party/${component}" DESTINATION "${package_root}/third-party")
endforeach()
file(COPY "@PROJECT_SOURCE_DIR@/LICENSE" "@PROJECT_SOURCE_DIR@/NOTICE" DESTINATION "${package_root}")
file(COPY "@PROJECT_SOURCE_DIR@/apps/THIRD_PARTY.md" DESTINATION "${package_root}/third-party")
file(COPY "@PROJECT_SOURCE_DIR@/docs/studio/runtime-package.md" DESTINATION "${package_root}")
file(RENAME "${package_root}/runtime-package.md" "${package_root}/README.md")
if(@MVKIT_USE_EIGEN@)
  file(COPY "@MVKIT_3RDPARTY_DIR@/eigen" DESTINATION "${package_root}/third-party")
endif()
foreach(license @mvkit_studio_license_files@)
  get_filename_component(parent "${license}" DIRECTORY)
  get_filename_component(component "${parent}" NAME)
  file(COPY "${license}" DESTINATION "${package_root}/third-party/${component}")
endforeach()
set(MVKIT_STUDIO_PACKAGE "${package_root}")
set(MVKIT_STUDIO_PACKAGE_CONFIG "${configuration}")
include("@PROJECT_SOURCE_DIR@/cmake/ValidateStudioPackage.cmake")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${package_root}" "${package_root}/*")
list(SORT files)
string(REPLACE ";" "\n" manifest "${files}")
file(WRITE "${package_root}/contents.txt" "${manifest}\n")
message(STATUS "MV Studio runtime ready: ${package_root}")
